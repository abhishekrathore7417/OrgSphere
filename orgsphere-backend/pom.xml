<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.orgsphere</groupId>
    <artifactId>orgsphere-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>orgsphere-parent</name>
    <description>Multi-tenant SaaS platform - Parent POM</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <twilio.version>9.0.0</twilio.version>
    </properties>

    <modules>
        <module>orgsphere-common</module>
        <module>orgsphere-security</module>
        <module>orgsphere-organization</module>
        <module>orgsphere-user</module>
        <module>orgsphere-subscription</module>
        <module>orgsphere-auth</module>
        <module>orgsphere-company</module>
        <module>orgsphere-school</module>
        <module>orgsphere-payment</module>
        <module>orgsphere-app</module>
    </modules>

    <!-- Shared dependency management (versions only, not included by default) -->
    <dependencyManagement>
        <dependencies>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-organization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-subscription</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-company</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-school</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orgsphere</groupId>
                <artifactId>orgsphere-payment</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Twilio -->
            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Dependencies inherited by ALL modules -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- Ensure Lombok annotation processor runs in every module -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
